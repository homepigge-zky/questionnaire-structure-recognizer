QSR_AUTH_MODE=local
QSR_DATA_DIR=questionnaire_structure_recognizer/data
QSR_MAX_UPLOAD_MB=30
QSR_WORKERS=1
QSR_MODEL_ENABLED=true
QSR_OLLAMA_URL=http://127.0.0.1:11434
QSR_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
QSR_MODEL_TIMEOUT=90
QSR_BATCH_MAX_CHARS=7000
QSR_MODEL_CONTEXT=4096
QSR_PDF_NATIVE_MIN_CHARS=20
QSR_OCR_ENABLED=false
# 本地转换器首次只用内置空白 DOCX 初始化；实际文件始终独立短路径 profile。
QSR_CONVERTER_INIT_TIMEOUT=180
QSR_CONVERT_TIMEOUT=100
# 可选短本地缓存目录；不填写则使用系统临时目录。
# QSR_CONVERTER_PROFILE_CACHE=D:/qsr-converter-profiles
QSR_OCR_DPI=220
QSR_OCR_IMAGE_MIN_PAGE_RATIO=0.03
QSR_MAX_PDF_PAGES=300
QSR_OCR_THREADS=2
# 不设置时依次检查系统 PATH 和项目 .tools/libreoffice/program/soffice.exe。
# LIBREOFFICE_PATH=D:/Tools/LibreOffice/program/soffice.exe
